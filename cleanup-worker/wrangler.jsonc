{
  // A plain Cloudflare Worker, deployed via `wrangler deploy` from this
  // directory -- deliberately NOT git-connected/Workers Builds (a
  // different, git-connected-Worker product that has had reliability
  // issues; this simpler mechanism doesn't have those problems). Deploy
  // manually whenever this changes:
  //   cd cleanup-worker && wrangler deploy
  // Secrets (see src/index.js's header comment for the full list) are set
  // separately, once, via `wrangler secret put <NAME>` or the dashboard --
  // they are NOT part of this file and are not committed anywhere.
  "name": "decap-preview-cleanup",
  "compatibility_date": "2026-08-12",
  "main": "src/index.js",
  "triggers": {
    // Sundays at 06:00 UTC. Cron syntax: minute hour day-of-month month
    // day-of-week. Named day (SUN) rather than numeric (0) — Cloudflare's
    // cron validator rejected "0 6 * * 0" outright (code 10100, "invalid
    // cron string") despite that being valid standard 5-field cron syntax
    // elsewhere.
    "crons": ["0 6 * * SUN"]
  },
  // One codebase, one place to fix bugs (npm-update-style consistency),
  // but each project gets its own isolated Worker + secrets — deliberately
  // NOT one shared running instance across projects. `CF_API_TOKEN` here
  // needs Edit (not just Read) to delete deployments, and `GITHUB_TOKEN`
  // needs repo read access; a single shared Worker would put every
  // project's credentials at risk from one leak/misconfiguration. Deploy
  // with `wrangler deploy --env <name>` — Cloudflare deploys each env
  // block as a fully separate Worker named `<name>-<env>` (confirmed via
  // Cloudflare's own docs: "Cloudflare effectively creates a new Worker
  // with the name `<top-level-name>-<environment-name>`"), so this can
  // never collide with or overwrite the top-level Worker above.
  "env": {
    "capitaledge": {
      "triggers": {
        // One hour offset from the top-level (djvrx) schedule — no real
        // requirement to stagger, just avoids both running at the exact
        // same instant for no reason.
        "crons": ["0 7 * * SUN"]
      }
    }
  }
}
